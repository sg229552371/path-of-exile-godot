# EditorConfig -- https://editorconfig.org
# Godot 4 GDScript 项目代码风格

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# GDScript：Godot 默认用 Tab 缩进
[*.gd]
indent_style = tab
indent_size = 4

# 标记 / 数据文件统一 2 空格缩进
[*.{json,md,yml,yaml,tscn,tres,cfg,import,sh}]
indent_style = space
indent_size = 2
